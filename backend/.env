# ========== SERVER ==========
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ========== DATABASE ==========
# ✅ این خط درست است - اگر رمز عبور PostgreSQL شما "postgres" است
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rasha_adalat?schema=public"

# ❌ اگر رمز عبور PostgreSQL شما چیز دیگری است، آن را جایگزین کنید
# مثال: اگر رمز عبور "123456" است
# DATABASE_URL="postgresql://postgres:123456@localhost:5432/rasha_adalat?schema=public"

# ========== REDIS ==========
# ⚠️ Redis اختیاری است - اگر ندارید، برنامه بدون آن اجرا می‌شود
REDIS_HOST=localhost
REDIS_PORT=6379

# ========== JWT ==========
# ⚠️ این کلیدها باید حداقل 32 کاراکتر باشند
JWT_ACCESS_SECRET=your-access-secret-key-min-32-characters-here
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-characters-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ========== ENCRYPTION ==========
# ⚠️ کلید رمزنگاری باید دقیقاً 32 کاراکتر باشد
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ========== OPENAI ==========
# ⚠️ اگر از AI استفاده نمی‌کنید، این مقدار را خالی بگذارید
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# ========== ZARINPAL ==========
# ⚠️ اگر پرداخت ندارید، این مقادیر را خالی بگذارید
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=http://localhost:5000/api/payments/verify
ZARINPAL_SANDBOX=true

# ========== EMAIL ==========
# ⚠️ اگر ایمیل ندارید، این مقادیر را خالی بگذارید
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ========== FILE UPLOAD ==========
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# ========== RATE LIMITING ==========
RATE_LIMIT_WINDOW=60000   # 1 دقیقه (همان)
RATE_LIMIT_MAX=1000       # افزایش از 100 به 1000
RATE_LIMIT_MAX_CHAT=200   # افزایش از 20 به 200

# ========== CORS ==========
CORS_ORIGIN=http://localhost:5173

# ========== LOGGING ==========
LOG_LEVEL=info
LOG_DIR=./logs


# 

GAPGPT_API_KEY=sk-YNzlB80LMuW0X4dCkrvALzx6BSH4Ydl946E0r03ofA1G2aoz
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gapgpt-qwen-3.5